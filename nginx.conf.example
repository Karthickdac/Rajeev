## Reverse-proxy config for Ungaludan Sarath
## Domain: ungaludansarath.com
##
## The Node app serves BOTH the website and the /api routes on port 5500, so the
## proxy just forwards everything to it.
##
## ── If you use CloudPanel (recommended on this server) ──────────────────
## You usually don't edit files by hand. In the CloudPanel UI:
##   1. Create a site of type "Reverse Proxy" (or "Node.js") for the domain.
##   2. Set the reverse-proxy target / app port to:  127.0.0.1:5500
##   3. Issue a Let's Encrypt certificate from the SSL tab.
## CloudPanel then generates the vhost for you — the block below is only a
## reference / for a plain-Nginx server.
##
## ── Plain Nginx ─────────────────────────────────────────────────────────
## Copy to: /etc/nginx/sites-available/ungaludan-sarath
## Then: ln -s /etc/nginx/sites-available/ungaludan-sarath /etc/nginx/sites-enabled/
## Then: nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name ungaludansarath.com www.ungaludansarath.com;

    # Allow large grievance attachments / image uploads.
    client_max_body_size 50M;

    # Everything (website + /api + /uploads + /media) → the Node app on 5500.
    location / {
        proxy_pass http://127.0.0.1:5500;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
    }
}

