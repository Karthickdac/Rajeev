# ── Ungaludan Sarath — environment for the VPS ──────────────────────────
# Copy this file to ".env" on the server and fill in REAL values.
# .env is gitignored — never commit real secrets.

# Postgres connection string for the production database on the VPS.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ungaludansarath

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port the Node app listens on (must match your reverse proxy / CloudPanel).
PORT=5500

# Public URL of the site — used for social OAuth callbacks (optional).
OAUTH_REDIRECT_BASE_URL=https://ungaludansarath.tamilagavetrikalagam.com

# ── Optional: social media one-click connect (leave blank if unused) ─────
# FB_APP_ID=
# FB_APP_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
